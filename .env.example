# Copy this file to .env and fill in your own values. Never commit .env.

# Groq API key, only needed for the examples and the opt-in live tests.
# The Groq SDK reads this variable by itself, so no code has to touch the key.
GROQ_API_KEY=your_groq_api_key_here

# Optional: model used by the examples. Provider model IDs are retired often,
# so check the provider's model list if the default stops working.
# GROQ_MODEL=openai/gpt-oss-20b
